# Kepçe Ortam Değişkenleri
# ========================
# Bu dosyayı `.env` olarak kopyalayın ve değerleri doldurun.

# --- Veritabanı ---
DATABASE_URL=postgresql://kepce_admin:SIFRE@localhost:5432/kepce
POSTGRES_USER=kepce_admin
POSTGRES_PASSWORD=SIFRE

# --- Güvenlik ---
KEPCE_SECRET_KEY=jwt-icin-guclu-bir-anahtar
# CORS İzinleri (KEPCE_CORS_ORIGIN):
# - Tek origin: http://localhost:5173
# - Çoklu origin (virgülle ayrılmış): http://localhost:5173,http://localhost:4173
# - Önemli: * olduğunda cookieler/kimlik doğrulama başlıkları tarayıcı tarafından engellenir
KEPCE_CORS_ORIGIN=http://localhost:5173

# --- Kimlik Doğrulama & İletişim ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- E-Posta / Şifresiz Giriş ---
RESEND_API_KEY=
KEPCE_BASE_URL=http://localhost:5173
# Amazon SES SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- AI / Menu Ayrıştırma (Opsiyonel) ---
# Sağlayıcı sırası. Varsayılan: OpenRouter (birincil) -> Gemini (yedek).
# Gemini Free Tier üretim kotası model başına 20 istek/gün olduğundan
# OpenRouter birincildir; "gemini,openrouter" ile ters çevrilebilir.
LLM_PROVIDER_ORDER=openrouter,gemini

# OpenRouter (birincil sağlayıcı). Base64 data: URI ile PDF/JPEG desteklenir.
OPENROUTER_API_KEY=
# Varsayılan: ~google/gemini-flash-latest (Gemini Flash ailesinin en günceli).
OPENROUTER_MODEL=~google/gemini-flash-latest
# Muhakeme seviyesi: max|xhigh|high|medium|low|minimal|none
OPENROUTER_REASONING_EFFORT=low
# Yanıt için üst token sınırı. Çok sayfalı PDF'lerde kesik JSON'u önlemek
# için yüksek tutulmalı. Varsayılan: 32000.
# OPENROUTER_MAX_TOKENS=32000
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Gemini (yedek sağlayıcı)
GEMINI_API_KEY=
# Birincil model. Otomatik yedek EKLENMEZ; kota dolarsa (429/503) dosya
# bekleyen'de kalır ve sonraki döngüde yeniden denenir. İstenirse açık liste:
#   GEMINI_MODEL=birincil,yedek
# YASAKLI: *-flash-lite* modelleri (uydurma/hatalı menü üretiyor) zincirden
# otomatik elenir.
# Not: Free Tier üretim kotası model başına 20 istek/gün olabilir.
GEMINI_MODEL=gemini-flash-latest
# Muhakeme (reasoning) seviyesi. Resmî alan: generation_config.thinking_level.
# Geçerli değerler: low | high.
GEMINI_THINKING_LEVEL=high

# --- Sayfa Yönü Düzeltmesi (Worker Ayrıştırma) ---
#   Modele gönderim öncesi sayfa yönünü (0/90/180/270) algılar ve düzeltir.
#   ONNX modeli imaja gömülüdür, ayrı indirme gerekmez. Varsayılan: açık.
#   0 | false | off | no verilerek kapatılır.
# ORIENTATION_CORRECTION=1
#   ONNX model dosyası yolu (container içi).
# ORIENTATION_MODEL_PATH=/app/models/doc_orientation.onnx
#   Yön taraması yapılacak en fazla PDF sayfası. Varsayılan: 50.
# ORIENTATION_MAX_PAGES=50

# --- Arama Motoru (SearXNG - Opsiyonel) ---
SEARXNG_URL=http://localhost:8080
SEARXNG_SECRET_KEY=searxng-icin-guclu-bir-anahtar

# --- Worker Ayarları ---
WORKER_LOCAL_INTERVAL_SECS=3600
WORKER_SCRAPER_INTERVAL_SECS=43200
WORKER_MENU_DIR=../data/menuler
#   IP-ban devre kesici (circuit breaker): kykyemek.com 403/israrci 429 ile
#   bizi banlarsa bu süre boyunca o domaine HİÇ istek atılmaz; fallback
#   kaynaklar (kykmenum/yurtmenu/kykmenu) çalışmaya devam eder.
#   Varsayılan: 21600 (6 saat).
# KYK_BAN_COOLDOWN_SECS=21600
#   kykyemek istekleri arası asgari aralık (ms). Tüm uç noktaları kapsar.
#   Varsayılan: 1000.
# KYK_MIN_REQUEST_INTERVAL_MS=1000
#   Tur başına en fazla dinamik Al Götür (fastmenu) isteği. Toplu istek
#   desenini kırar. Varsayılan: 20.
# KYK_FASTMENU_MAX_PER_CYCLE=20
#   Devre kesici durum dosyası ve Al Götür önbelleği. Kalıcı volume üzerinde
#   tutulur; yeniden başlatmada sabıka ve önbellek korunur.
# KYK_BAN_STATE_FILE=/app/cache/kyk_ban_until
# TAKEAWAY_CACHE_FILE=/app/cache/takeaway.json
#   fastembed gömme (embedding) modeli önbelleği. Yazılabilir dizin olmalı.
# FASTEMBED_CACHE_DIR=/app/.fastembed_cache
#   Bir dosyadan çıkarılan gün sayısı, beklenen aya göre bu oranın altında
#   kalırsa WARN loglanır; sessiz veri kaybını görünür kılar. Varsayılan: 0.6
# WORKER_MIN_DAYS_RATIO=0.6
#   Drop-Zone Dizin İzinleri (WORKER_MENU_DIR):
#   Bu dizin worker'ın yerel dosya tarama (file_ingest) hedefidir.
#   İçine bırakılan her .xlsx/.pdf dosyası otomatik olarak işlenir.
#   GÜVENLİK: Sadece uygulama kullanıcısının yazma izni olmalıdır.
#   Önerilen izinler:
#     sudo chown kepce:kepce /path/to/menuler
#     sudo chmod 700 /path/to/menuler
#   PDF dosyaları Gemini API'ye gönderilir - dizine dışarıdan dosya
#   bırakılabilmesi veri sızıntısı riski oluşturur.

# --- IndexNow Otomasyonu (Opsiyonel, Faz 1.6) ---
#   Scraper döngüsü sonunda yeni menülerin kanonik /{sehir}/{tarih} gün
#   URL'lerini IndexNow'a bildirir. Boş/atanmamışsa özellik KAPALI.
#   Değer, webapp/static/<KEY>.txt dosyasının adıyla birebir aynı olmalı.
INDEXNOW_KEY=
# INDEXNOW_HOST=kepce.org
# INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow

# --- Loglama ---
RUST_LOG=info

# --- İlk Admin Kurulumu ---
INITIAL_ADMIN_EMAIL=admin@kepce.org
INITIAL_ADMIN_PASSWORD=kepce_admin_123

# --- Web Push (VAPID) ---
# RFC 8292 Web Push bildirimleri için EC P-256 anahtar çifti.
# Üretmek için: openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 | openssl pkcs8 -topk8 -nocrypt
# Public key'i türetmek için: openssl pkey -pubout -outform DER | tail -c 65 | base64 | tr '+/' '-_' | tr -d '='
VAPID_PUBLIC_KEY=BOBojldYJoJKoFLnteHRQCOQSgCrX-8Pa94oCYTIf-VuqHSK_FyfUO5As2ktLEmcr4sbIo-2gWKEDfMpVxuwi3g
VAPID_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<PKCS8-EC-P256-private-key>\n-----END PRIVATE KEY-----"
VAPID_SUBJECT=mailto:iletisim@kepce.org