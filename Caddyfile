		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
}

# www -> apex kalici yonlendirme. Cloudflare edge tarafinda bir Redirect Rule da
# vardir, ancak origin seviyesinde de tanimli olmasi o kuralin kaybolmasina karsi
# korur ve www uzerinden kopya icerik servis edilmesini engeller.
www.kepce.org {
	tls /etc/caddy/certs/origin.crt /etc/caddy/certs/origin.key
	redir https://kepce.org{uri} permanent
}

kepce.org {
	tls /etc/caddy/certs/origin.crt /etc/caddy/certs/origin.key
	encode zstd gzip

	# 5651 Sayılı Kanun Uyumlu Erişim Logları
	# Anonim kamu menü okuma ve statik varlık istekleri Fransa sunucusuna loglanmaz (drop edilir).
	# Yalnızca içerik üreten, kayıt olan veya veri ileten etkileşimli istekler 5651 kapsamında loglanır.
	@skip_public_logs {
		method GET HEAD POST PUT DELETE
		not path /moderasyon/* /api/v1/admin/* /api/v1/moderation/*
	}
	log_skip @skip_public_logs

	log {
		output file /var/log/caddy/access.log {
			roll_size 50mb
			roll_keep 365
			roll_keep_for 8760h
		}
		format json
	}

	# Güvenlik Başlıkları (Security Headers)
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		?Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; font-src 'self' data:; img-src 'self' data: blob: https:; script-src 'self' 'strict-dynamic' https://static.cloudflareinsights.com https://analitik.kepce.org; style-src 'self' 'unsafe-inline'; connect-src 'self' https://cloudflareinsights.com https://analitik.kepce.org; frame-ancestors 'none';"
	}

	# SEO: Arama motorları JSON API'yi indekslemesin
	@api_paths path /api/*
	header @api_paths X-Robots-Tag "noindex, nofollow"

	# SEO: Trailing-slash normalizasyonu (/ankara/ -> /ankara)
	# NOT: path * / matcher'i "her sey OR /" anlamina geldigi icin tum istekleri
	# //path seklinde protocol-relative URL'ye yonlendiriyordu; regexp kullanilir.
	@trailing_slash path_regexp trailing ^/(.+)/$
	redir @trailing_slash /{re.trailing.1} 308

	# Kullanıcıya özel sayfalar asla edge/cache'lenmez (güvenlik)
	@private_pages {
		path /ben /ben/* /ayarlar /ayarlar/* /bildirimler /bildirimler/* /moderasyon /moderasyon/* /giris /kayit /oauth /oauth/* /auth /auth/* /sifre-yenile /profili-tamamla /gelistirici /gelistirici/*
	}
	header @private_pages Cache-Control "private, no-store"

	# Statik fontlar ve kalıcı varlıklar için 1 yıl (immutable) önbellekleme
	@immutable_assets {
		path /fonts/* *.woff2 *.woff *.ttf /internal/immutable/* /agpl-v3.svg /og_image.png
	}
	header @immutable_assets >Cache-Control "public, max-age=31536000, immutable"

	# Statik meta ve simge dosyaları için önbellek kuralları (manifest.json, favicon vb.)
	@static_meta {
		path /manifest.json /favicon.ico /favicon.svg /favicon-ara.svg /favicon-48x48.png /apple-touch-icon.png /icon-*.png
	}
	header @static_meta Cache-Control "public, max-age=604800, stale-while-revalidate=86400"

	# Statik bakım dosyası servisi
	root * /srv/static

	# /ara isteklerini ara.kepce.org'a yönlendir
	redir /ara https://ara.kepce.org 302
	redir /ara/* https://ara.kepce.org/{path} 302

	# 1. API istekleri -> Rust API container'ı (api:8000)
	handle /api/* {
		reverse_proxy api:8000 {
			header_up X-Real-IP {http.request.header.CF-Connecting-IP}
			header_up X-Real-Port {http.request.header.X-Client-Port}
		}
	}

	# 2. Statik yüklemeler (avatarlar vb.) -> Rust API container'ı (api:8000)
	handle /static/* {
		reverse_proxy api:8000
	}

	# 3. Ön yüz (SvelteKit SSR) -> Node container'ı (webapp:3000)
	handle {
		reverse_proxy webapp:3000
	}

	# 4. 502 / 503 hatasında Özel Bakım Sayfası
	handle_errors {
		@maintenance expression `{err.status_code} in [502, 503]`
		rewrite @maintenance /maintenance.html
		file_server
	}
}

ara.kepce.org {
	tls /etc/caddy/certs/origin.crt /etc/caddy/certs/origin.key
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
	}

	# Arama motorlarının dinamik arama sorgu sayfalarını indekslemesini engelle
	@search_results query q=*
	header @search_results X-Robots-Tag "noindex, nofollow, noarchive"

	# Favicon yönlendirmesi
	rewrite /favicon.ico /favicon-ara.svg
	rewrite /favicon.svg /favicon-ara.svg

	log {
		output discard
	}

	# 1. API istekleri -> Rust API container'ı (api:8000)
	handle /api/* {
		reverse_proxy api:8000 {
			header_up X-Real-IP {http.request.header.CF-Connecting-IP}
			header_up X-Real-Port {http.request.header.X-Client-Port}
		}
	}

	# 2. Statik yüklemeler (avatarlar vb.) -> Rust API container'ı (api:8000)
	handle /static/* {
		reverse_proxy api:8000
	}

	# 3. Ön yüz (SvelteKit SSR) -> Node container'ı (webapp:3000)
	handle {
		reverse_proxy webapp:3000
	}
}

analitik.kepce.org {
	tls /etc/caddy/certs/origin.crt /etc/caddy/certs/origin.key
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
	}

	log {
		output discard
	}

	reverse_proxy umami:3000
}
